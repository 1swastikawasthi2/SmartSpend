<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Roommate Bill Splitter</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h2>🍕 Roommate & Mess Bill Splitter</h2>
        
        <form action="/split/add" method="POST" class="budget-form">
            <div class="form-group">
                <label>Bill Description (e.g., Weekend Pizza / Mess Bill):</label>
                <input type="text" name="title" required>
            </div>
            <div class="form-group">
                <label>Total Amount (₹):</label>
                <input type="number" name="totalAmount" required>
            </div>
            <div class="form-group">
                <label>Paid By:</label>
                <input type="text" name="paidBy" placeholder="e.g., Rohan" required>
            </div>
            <div class="form-group">
                <label>Participants (Comma-separated names):</label>
                <input type="text" name="participants" placeholder="Rohan, Amit, Rahul" required>
            </div>
            <button type="submit" class="btn">Calculate & Save Split</button>
        </form>

        <h3 style="margin-top: 30px;">Active Split Records</h3>
        <ul>
            <% bills.forEach(b => { %>
                <li style="margin-bottom: 10px; background: #f9fafb; padding: 10px; border-radius: 6px;">
                    <strong><%= b.title %></strong> - ₹<%= b.totalAmount %> (Paid by <%= b.paidBy %>) <br>
                    <small>Share per person: ₹<%= b.perPersonShare.toFixed(2) %> (<%= b.participants.join(', ') %>)</small>
                </li>
            <% }) %>
        </ul>
        
        <br>
        <a href="/" class="btn" style="background: #4f46e5; color: white; text-decoration: none; padding: 8px 15px; border-radius: 5px;">Back to Dashboard</a>
    </div>
</body>
</html>